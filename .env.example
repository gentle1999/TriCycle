# Runtime environment variables for the Bohr / Bohrium adapter. Declarative
# requests and run configuration belong in TOML; keep secrets local. The
# project automatically discovers .env in the current directory or a parent.
BOHR_BIN=bohr
# Current bohr CLI releases use BOHR_ACCESS_KEY:
BOHR_ACCESS_KEY=
# Legacy Bohrium CLI installations used ACCESS_KEY:
# ACCESS_KEY=
# The following values are used as defaults when the request TOML omits them.
BOHR_PROJECT_ID=
BOHR_MACHINE_TYPE=
BOHR_IMAGE=registry.dp.tech/dptech/dp/native/prod-23278/gaussian-orca-dp-client:260824
# Default worker image for SAR/RitS requests when their TOML omits image.
BOHR_ML_IMAGE=registry.dp.tech/dptech/dp/native/prod-23278/ubuntu2404-py312-pt212-cu130-dl:260831

# Reaction database adapter settings.
TRICYCLE_REACTION_DB_URL=
TRICYCLE_REACTION_DB_TOKEN=

# Default local run directory.
TRICYCLE_RUN_ROOT=./runs
