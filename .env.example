# Runtime environment variables for the Bohr / Bohrium adapter. Declarative
# requests and run configuration belong in TOML; keep secrets local. The
# project automatically discovers .env in the current directory or a parent.
BOHR_BIN=bohr
# Current bohr CLI releases use BOHR_ACCESS_KEY:
BOHR_ACCESS_KEY=
# Legacy Bohrium CLI installations used ACCESS_KEY:
# ACCESS_KEY=
# The following values are used as defaults when the request TOML omits them.
BOHR_PROJECT_ID=
BOHR_MACHINE_TYPE=
BOHR_IMAGE=registry.dp.tech/dptech/dp/native/prod-23278/gaussian-orca-dp-client:260824
# Default worker image for SAR/RitS requests when their TOML omits image.
BOHR_ML_IMAGE=registry.dp.tech/dptech/dp/native/prod-23278/ubuntu2404-py312-pt212-cu130-dl:260831

# Reaction database MCP adapter settings.
# The live adapter uses the database's Streamable HTTP MCP endpoint.  A plain
# service URL is also accepted and is normalized to /mcp/.
TRICYCLE_REACTION_DB_MCP_URL=
TRICYCLE_REACTION_DB_MCP_TOKEN=
TRICYCLE_REACTION_DB_MCP_APP_NAME=example-chemistry-database
# Compatibility fallbacks for existing local environments:
TRICYCLE_REACTION_DB_URL=
TRICYCLE_REACTION_DB_TOKEN=
# Required by the MCP create_project tool when the request omits
# [project].organization_id.
TRICYCLE_REACTION_DB_ORGANIZATION_ID=
# Keep TLS verification enabled unless the service uses a private CA.
TRICYCLE_REACTION_DB_MCP_VERIFY_TLS=true
TRICYCLE_REACTION_DB_MCP_CA_BUNDLE=
TRICYCLE_REACTION_DB_MCP_TIMEOUT_SECONDS=60
TRICYCLE_REACTION_DB_MCP_PAGE_SIZE=200
# Default durable upload transport: batch multipart; "mcp" keeps the
# single-file upload_calculation_log compatibility path.
TRICYCLE_REACTION_DB_MCP_UPLOAD_MODE=batch

# Default local run directory.
TRICYCLE_RUN_ROOT=./runs
