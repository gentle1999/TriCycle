"""Static interface for the accompanying runtime implementation."""

from __future__ import annotations

from pathlib import Path
from typing import Any

def write_report(path: Path, values: dict) -> None: ...

class AcceleratorGuard:
    def __init__(
        self, expected: str, report: Path, *, training: bool, optimizer: bool = ...
    ) -> None: ...
    def publish(self) -> None: ...
    def tensor(self, tensor: Any) -> None: ...
    def tensors(self, value: Any) -> None: ...
    def inputs(self, value: Any) -> None: ...
    def __enter__(self) -> Any: ...
    def __exit__(self, exc_type: Any, exc: Any, traceback: Any) -> Any: ...
